rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Alerts - read/write open for demo
    match /alerts/{alertId} {
      allow read, write: if true;
    }

    // Historical data - read/write open for demo
    match /historical_data/{docId} {
      allow read, write: if true;
    }

    // Guards - read/write open for demo
    match /guards/{guardId} {
      allow read, write: if true;
    }
  }
}
